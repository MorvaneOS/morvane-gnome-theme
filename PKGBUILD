# Maintainer: Clove Twilight <clove@doughmination.gay>
#
# The MorvaneOS look as GNOME's default. Everything installed is generated by
# tools/build.py and committed, so building the package needs nothing but the repo.

pkgname=morvane-gnome-theme
pkgver=1.0.0
pkgrel=1
pkgdesc='MorvaneOS look for GNOME: GTK theme, colours, icons, cursor and wallpapers by default'
arch=(any)
url='https://github.com/MorvaneOS/morvane-gnome-theme'
license=(LGPL-2.1-or-later)
depends=(
  morvane-gtk-theme   # GTK themes, libadwaita colours, icons and cursor
  morvane-wallpapers
)

# glib2's pacman hook compiles the schemas after install, upgrade and removal
package() {
  install -Dm644 "$startdir"/schemas/90_morvane-gnome-theme.gschema.override -t "$pkgdir/usr/share/glib-2.0/schemas/"
}
