# MorvaneOS default look for GNOME: generated by tools/build.py, edit that instead.

[org.gnome.desktop.interface]
color-scheme='prefer-dark'
accent-color='pink'
gtk-theme='MorvaneOS-Dark'
icon-theme='candy-icons'
cursor-theme='sandrone-linux'

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/morvaneos/twilight.png'
picture-uri-dark='file:///usr/share/backgrounds/morvaneos/twilight.png'
picture-options='zoom'
primary-color='#120C16'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/morvaneos/minimal.png'
picture-options='zoom'
primary-color='#120C16'
